#!/bin/bash
# Session entrypoint (root-owned): the isolation checks must pass before Claude Code starts.
# Arguments go to claude only; nothing a caller passes can skip the checks.
set -u
if ! /usr/local/bin/agent-checks.sh; then
  echo "agent-session: a critical isolation check failed; Claude Code was NOT started." >&2
  exit 1
fi

# One session per container: sessions share the one checkout, so a second session's refresh or branch switch
# moves the first one's work (seen: two parallel sessions, and one session's commit landed on the other's
# branch). Taken before the refresh below. fd 9 is inherited through exec, so Claude Code holds the lock until it
# exits (background processes it leaves running hold it too; `bin/agent down` clears them).
LOCK=/work/.agent-session.lock
if ! { exec 9>"$LOCK" && flock -n 9; }; then
  echo "agent-session: another session is already running in this container; Claude Code was NOT started." >&2
  echo "agent-session: finish or /exit that session first (one checkout, one session)." >&2
  exit 1
fi

cd /work/ai-subtitles || { echo "agent-session: /work/ai-subtitles missing; run bin/agent up" >&2; exit 1; }

# The clone lives in a volume and outlives image rebuilds. Without this, a session reads the CLAUDE.md,
# agents and hooks of whatever commit it last checked out (seen: a session ran on main from before #62).
# Only a clean tree is moved; local branches and their commits stay where they are.
warn() { printf '\nagent-session: WARNING: %s\n\n' "$1" >&2; }
if ! git fetch -q origin main; then
  warn "could not fetch origin/main; instructions and agents may be out of date."
elif [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  warn "uncommitted changes on $(git rev-parse --abbrev-ref HEAD); not updated. main is $(git rev-list --count main..origin/main) commit(s) behind origin/main."
elif ! { git switch -q main && git merge -q --ff-only origin/main; }; then
  warn "could not fast-forward main to origin/main; instructions and agents may be out of date."
else
  echo "agent-session: on main at $(git rev-parse --short HEAD) (origin/main)"
fi
exec claude "$@"
