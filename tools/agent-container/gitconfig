# System git config (root-owned). The only GitHub credential is the short-lived GitHub App token that
# bin/agent writes to /run/agent-token; it is scoped to this repository.
[credential "https://github.com"]
	helper = /usr/local/bin/git-credential-agent
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
# Commits from the container are the GitHub App's, never the owner's; GitHub links this address to the bot account.
[user]
	name = ugur22-ai-subs-agent[bot]
	email = 360600933+ugur22-ai-subs-agent[bot]@users.noreply.github.com
