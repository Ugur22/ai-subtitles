# Local mode reference — you normally do NOT need this file:
# scripts/run-local.sh exports these as environment variables (which override
# backend/.env), so your existing .env is used as-is and never modified.
# Copy values from here only if you want to run uvicorn manually without the script.
# Local mode = SQLite instead of Supabase, local disk instead of GCS,
# subprocess instead of Cloud Run Jobs.

LOCAL_MODE=true

# Keep GCS "enabled" so the pipeline stays on its primary code path
# (screenshot upload, image indexing, face presence). In LOCAL_MODE the
# storage service behind this flag writes to local disk, not GCS.
ENABLE_GCS_UPLOADS=true

# Where the local SQLite DB, uploads, logs, and encryption key live
LOCAL_DATA_DIR=./local_data
LOCAL_BASE_URL=http://localhost:8000

# Whisper on Apple Silicon: ctranslate2 has no MPS support, cpu/int8 is fastest
FASTWHISPER_MODEL=small
FASTWHISPER_DEVICE=cpu
FASTWHISPER_COMPUTE_TYPE=int8

# Speaker diarization (pyannote) runs on MPS automatically.
# Requires a HuggingFace token once, to download the gated models:
#   1. https://huggingface.co/pyannote/speaker-diarization-3.1 -> accept terms
#   2. https://huggingface.co/pyannote/segmentation-3.0 -> accept terms
#   3. https://huggingface.co/settings/tokens -> create a read token
ENABLE_SPEAKER_DIARIZATION=true
HUGGINGFACE_TOKEN=

# Chat LLM: "local" uses Ollama at http://localhost:11434 (ollama pull llama3.2:3b).
# Optionally set GROQ_API_KEY / XAI_API_KEY and change the provider.
DEFAULT_LLM_PROVIDER=local
OLLAMA_MODEL=llama3.2:3b

# Frontend dev server origin (backend default already allows this)
CORS_ORIGINS=["http://localhost:5173"]

# Leave Supabase/GCS/Stripe unset — LOCAL_MODE never contacts them.
